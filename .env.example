MUCHEN_DATA_MODE=demo
MUCHEN_DATA_SERVICE_URL=http://127.0.0.1:8090
# 可选：配置后 Python 网关只接受携带 x-muchen-gateway-token 的服务端调用。
MUCHEN_GATEWAY_TOKEN=
MUCHEN_INVITE_CODE=MC-7DAY-DEMO
MUCHEN_SESSION_SECRET=
# 必须配置 32 字符以上的随机会话密钥；邮箱验证使用 Resend。
RESEND_API_KEY=
MUCHEN_MAIL_FROM=
MUCHEN_ADMIN_EMAILS=admin@example.com
# 本地开发留空时使用进程内演示存储；生产必须配置 PostgreSQL。
DATABASE_URL=
# Required for the /support console. Use dedicated, non-public values (32+ characters for both secrets).
MUCHEN_SUPPORT_EMAILS=
MUCHEN_SUPPORT_ACCESS_KEY=
MUCHEN_SUPPORT_SESSION_SECRET=
IFIND_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-stock-mcp
IFIND_MCP_AUTH_KEY=
IFIND_MCP_AUTH_MODE=raw
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 会话应急吊销：轮换此整数会让所有已签发的用户/客服会话立即失效。默认 0。
MUCHEN_SESSION_EPOCH=0

# 安全配置说明：
# - MUCHEN_SESSION_SECRET 在所有环境都必须 >=32 字符，不再有开发用硬编码回退。
# - MUCHEN_SUPPORT_SESSION_SECRET 必须与 MUCHEN_SESSION_SECRET 不同，且 >=32 字符。
# - 登录/客服 Cookie 始终带 Secure；本地请用 http://localhost 访问。
# - 远程 PostgreSQL 连接串请显式带 sslmode=require，否则服务端会强制启用 TLS。
# - 部署层需覆盖 X-Real-IP（或让可信代理追加 X-Forwarded-For），
#   客服登录与发信限流依赖可信客户端地址，不接受客户端伪造的最左 XFF。
